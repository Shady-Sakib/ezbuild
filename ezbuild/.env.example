# Copy this file to .env (git-ignored) and fill in what you need.
# Keep optional keys commented until you have a value; empty values are skipped. Startup logs which keys were loaded.

MONGODB_URI=mongodb://localhost:27017/ezbuild?replicaSet=rs0&directConnection=true
BASE_URL=http://localhost:1010
SEED=true

# Optional: long random secrets (PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48)))
# JWT_SECRET=
# REMEMBER_ME_KEY=
# SEED_ADMIN_PASSWORD=Admin@123

# Set to false when MongoDB is a standalone server (no replica set, so no multi-document transactions).
# MONGO_TRANSACTIONS=false

# AI assistant: Google AI Studio key. Without one, set AI_PROVIDER=none and the assistant runs in rule-based mode.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# AI_PROVIDER=none
# Google Search grounding for the assistant; on by default whenever GEMINI_API_KEY is set.
# AI_WEB_SEARCH=false
# ADVISOR_MODE=remote
# ADVISOR_URL=http://localhost:1020
# ADVISOR_KEY=local-dev-service-key

# SSLCommerz sandbox credentials (free sign-up: https://developer.sslcommerz.com/registration/).
# SSLC_STORE_ID=
# SSLC_STORE_PASS=

# Stripe test-mode keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BDT_PER_USD=122

# Mail. Leave unset and emails are written to the log instead.
# MAIL_HOST=smtp.gmail.com
# MAIL_USER=
# MAIL_PASSWORD=
